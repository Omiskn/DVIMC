<!--
  Temporary application shell.

  While the floating radial widget is being built, this window doubles as the design-system
  preview: every colour token, type style, icon and control style is shown in the running
  application so it can be judged and compared against docs/ART_DIRECTION.md.

  It is replaced by the floating radial widget in Phase 2.
-->
<Window x:Class="FluxConvert.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FluxConvert.App"
        xmlns:controls="clr-namespace:FluxConvert.App.Controls"
        xmlns:conv="clr-namespace:FluxConvert.App.Converters"
        Title="FluxConvert - Design preview"
        Width="960"
        Height="820"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{StaticResource Surface.Base}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.Family}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometry" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">

            <!-- ============================ Header ============================ -->
            <StackPanel>
                <TextBlock Style="{StaticResource Type.Display}" Text="FluxConvert" />
                <TextBlock Style="{StaticResource Type.Subtitle}"
                           Margin="0,4,0,0"
                           Text="Design system preview - the colour tokens, type scale, icon set and control styles of the floating interface." />
            </StackPanel>

            <!-- =========================== Palette ============================ -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Overline}" Text="COLOUR PALETTE" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Swatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Swatch}">
                                <StackPanel Width="118" Margin="0,0,14,14">
                                    <Border Height="42"
                                            CornerRadius="8"
                                            Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="{StaticResource Border.Strong}"
                                            BorderThickness="1" />
                                    <TextBlock Style="{StaticResource Type.Label}"
                                               Margin="0,6,0,0"
                                               Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Type.Caption}" Text="{Binding Hex}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ========================== Typography ========================== -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Overline}" Text="TYPOGRAPHY" />
                    <TextBlock Style="{StaticResource Type.Display}" Margin="0,12,0,0" Text="Display 28" />
                    <TextBlock Style="{StaticResource Type.Title}" Margin="0,10,0,0" Text="Title 15 - photo.png" />
                    <TextBlock Style="{StaticResource Type.Subtitle}" Margin="0,6,0,0" Text="Subtitle 13 - a supporting line" />
                    <TextBlock Style="{StaticResource Type.Body}" Margin="0,6,0,0" Text="Body 12.5 - ordinary running text" />
                    <TextBlock Style="{StaticResource Type.Label}" Margin="0,6,0,0" Text="Label 12 - a radial item label" />
                    <TextBlock Style="{StaticResource Type.Caption}" Margin="0,6,0,0" Text="Caption 11 - metadata and hints" />
                    <TextBlock Style="{StaticResource Type.Overline}" Margin="0,10,0,0" Text="OVERLINE 10 - SECTION HEADING" />
                </StackPanel>
            </Border>

            <!-- ============================ Icons ============================= -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Overline}" Text="ICON SET" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Icons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:IconEntry}">
                                <StackPanel Width="92" Margin="0,0,14,16">
                                    <Button Style="{StaticResource RadialItemBadge}"
                                            Foreground="{StaticResource Text.Secondary}"
                                            IsEnabled="True"
                                            ToolTip="{Binding Name}">
                                        <Path Style="{StaticResource IconPath}"
                                              Data="{Binding ResourceKey, Converter={StaticResource ResourceKeyToGeometry}}" />
                                    </Button>
                                    <TextBlock Style="{StaticResource Type.Caption}"
                                               Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======================= Item badge states ====================== -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Overline}" Text="RADIAL ITEM BADGE STATES" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <StackPanel Width="104">
                            <Button Style="{StaticResource RadialItemBadge}"
                                    Foreground="{StaticResource Accent.Magenta}"
                                    ToolTip="Rest">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Image}" />
                            </Button>
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Rest" />
                        </StackPanel>
                        <StackPanel Width="104">
                            <Button x:Name="FocusExample"
                                    Style="{StaticResource RadialItemBadge}"
                                    Foreground="{StaticResource Accent.Violet}"
                                    ToolTip="Keyboard focus">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Video}" />
                            </Button>
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Focused" />
                        </StackPanel>
                        <StackPanel Width="104">
                            <Button Style="{StaticResource RadialItemBadge}"
                                    controls:RadialItem.IsSelected="True"
                                    Foreground="{StaticResource Accent.Teal}"
                                    ToolTip="Selected">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Audio}" />
                            </Button>
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Selected" />
                        </StackPanel>
                        <StackPanel Width="104">
                            <Button Style="{StaticResource RadialItemBadge}"
                                    IsEnabled="False"
                                    ToolTip="Unsupported">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}" />
                            </Button>
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Disabled" />
                        </StackPanel>
                        <StackPanel Width="104">
                            <Button Style="{StaticResource RadialItemBadge}"
                                    Foreground="{StaticResource Text.Secondary}"
                                    ToolTip="Opens a submenu">
                                <Grid>
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Settings}" />
                                    <Path Style="{StaticResource IconPath.Small}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,-4,-2"
                                          Data="{StaticResource Icon.ChevronRight}" />
                                </Grid>
                            </Button>
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Submenu" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================= Widget parts ========================= -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.Overline}" Text="CORE DISC, DETAIL STRIP AND PROGRESS RING" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Style="{StaticResource CoreDisc}" Margin="0,0,28,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Type.Title}"
                                           HorizontalAlignment="Center"
                                           Text="photo.png" />
                                <TextBlock Style="{StaticResource Type.Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Text="PNG - 1.8 MB" />
                            </StackPanel>
                        </Border>

                        <Grid Width="132" Height="132" Margin="0,0,28,0">
                            <controls:ProgressRing Value="0.35" />
                            <TextBlock Style="{StaticResource Type.Metric}" Text="35%" />
                        </Grid>

                        <Grid Width="132" Height="132" Margin="0,0,28,0">
                            <controls:ProgressRing IsIndeterminate="True" />
                            <TextBlock Style="{StaticResource Type.Caption}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="working" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource DetailStrip}" Margin="0,24,0,0" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Type.Label}" Text="Images" />
                                <TextBlock Style="{StaticResource Type.Caption}"
                                           Margin="0,2,0,0"
                                           Text="Convert to PNG, JPEG, WEBP, AVIF, BMP, TIFF, GIF or ICO." />
                            </StackPanel>
                            <Path Grid.Column="1"
                                  Style="{StaticResource IconPath}"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.ChevronRight}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
