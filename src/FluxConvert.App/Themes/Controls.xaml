<!--
  Reusable control styles.

  Source of truth: docs/ART_DIRECTION.md § 3.5. Every radial item is a real button, so keyboard
  navigation, focus handling and screen-reader support come from the framework.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FluxConvert.App.Controls">

    <!-- ============================ Icon paths ========================== -->

    <!--
      The stroke colour is taken from the surrounding button's Foreground, so a badge can tint
      its icon per category and the hover state can brighten it. The fallback keeps the style
      usable outside a button.
    -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue={StaticResource Text.Primary}}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource Size.Icon}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A smaller, slightly heavier glyph for inline affordances such as the submenu chevron. -->
    <Style x:Key="IconPath.Small" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="{StaticResource Size.IconSmall}" />
        <Setter Property="Height" Value="{StaticResource Size.IconSmall}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- ========================== Radial item =========================== -->

    <!--
      The badge that sits on the ring. Four visible states, each distinguishable without
      relying on colour alone: the hover state also grows the badge, the focused and selected
      states also thicken the border, and the disabled state also dims it.
    -->
    <Style x:Key="RadialItemBadge" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.ItemBadge}" />
        <Setter Property="Height" Value="{StaticResource Size.ItemBadge}" />
        <Setter Property="Background" Value="{StaticResource Surface.Item}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Badge"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Surface.ItemHover}" />
                            <Setter TargetName="Badge" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Surface.ItemFocus}" />
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent.Blue}" />
                            <Setter TargetName="Badge" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="controls:RadialItem.IsSelected" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Surface.ItemFocus}" />
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent.Blue}" />
                            <Setter TargetName="Badge" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Badge" Property="Effect" Value="{StaticResource Shadow.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Badge" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== Core disc ============================ -->

    <!-- The opaque disc in the middle of the ring. -->
    <Style x:Key="CoreDisc" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.CoreDisc}" />
        <Setter Property="Height" Value="{StaticResource Size.CoreDisc}" />
        <Setter Property="Background" Value="{StaticResource Gradient.CoreDisc}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================== Detail strip ========================== -->

    <!-- The bar below the ring that describes the hovered or selected item. -->
    <Style x:Key="DetailStrip" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.StripWidth}" />
        <Setter Property="Height" Value="{StaticResource Size.StripHeight}" />
        <Setter Property="Background" Value="{StaticResource Surface.Strip}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="{StaticResource Space.Medium}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================== Cards ============================= -->

    <!-- A plain panel used for grouped content. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="{StaticResource Space.Large}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A small, square, low-emphasis button. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="{StaticResource Space.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Item}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent.Blue}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
