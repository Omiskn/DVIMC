<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Globalization is deliberately NOT invariant: WPF resolves the culture of every binding,
         and an invariant runtime has no 'en-US' culture to resolve, which makes the interface
         throw at start-up. A desktop application also has to format numbers and dates the way
         the user's locale expects. -->
    <Product>FluxConvert</Product>
    <Company>FluxConvert</Company>
    <Authors>FluxConvert</Authors>
    <Copyright>Copyright (c) FluxConvert</Copyright>
    <!-- Working product name. Branding is not final; keep it in one place (see src/FluxConvert.Core/ProductInfo.cs). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
