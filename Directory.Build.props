<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>FluxConvert</Product>
    <Company>FluxConvert</Company>
    <Authors>FluxConvert</Authors>
    <Copyright>Copyright (c) FluxConvert</Copyright>
    <!-- Working product name. Branding is not final; keep it in one place (see src/FluxConvert.Core/ProductInfo.cs). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
